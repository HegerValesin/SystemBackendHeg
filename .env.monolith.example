POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=logistica_db
# Necessário ao executar `npm run dev:monolith` fora do Docker.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=troque-por-uma-senha-forte
DB_DATABASE=logistica_db
# Comunicação interna do monólito. Não exponha esta porta externamente.
MONOLITH_TCP_HOST=127.0.0.1
MONOLITH_TCP_PORT=3001
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=15m
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=troque-esta-chave
MINIO_SECRET_KEY=troque-por-uma-senha-forte
MINIO_BUCKET=documents
MINIO_REGION=us-east-1
RABBITMQ_DEFAULT_USER=logistica
RABBITMQ_DEFAULT_PASS=troque-por-uma-senha-forte
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
# Use true apenas no primeiro banco local vazio. Em produção, deixe false.
DB_SYNCHRONIZE=true
