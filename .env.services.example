# Auth DB
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=troque-esta-senha
AUTH_DB_DATABASE=auth_db

# Registry DB
REGISTRY_DB_HOST=localhost
REGISTRY_DB_PORT=5433
REGISTRY_DB_USERNAME=postgres
REGISTRY_DB_PASSWORD=troque-esta-senha
REGISTRY_DB_DATABASE=registry_db

# Operations DB
OPERATIONS_DB_HOST=localhost
OPERATIONS_DB_PORT=5434
OPERATIONS_DB_USERNAME=postgres
OPERATIONS_DB_PASSWORD=troque-esta-senha
OPERATIONS_DB_DATABASE=operations_db

# Documents DB
DOCUMENTS_DB_HOST=localhost
DOCUMENTS_DB_PORT=5435
DOCUMENTS_DB_USERNAME=postgres
DOCUMENTS_DB_PASSWORD=troque-esta-senha
DOCUMENTS_DB_DATABASE=documents_db

# RabbitMQ (produção: broker gerenciado ou servidor externo)
RABBITMQ_URL=amqp://logistica:troque-esta-senha@rabbitmq:5672
RABBITMQ_DEFAULT_USER=logistica
RABBITMQ_DEFAULT_PASS=troque-esta-senha
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY_MS=10000
RABBITMQ_DLQ_REQUEUE_LIMIT=10
RABBITMQ_DLQ_ALERT_THRESHOLD=1
RABBITMQ_MONITOR_INTERVAL_MS=60000
OUTBOX_LOCK_TIMEOUT_MS=60000

# External MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=troque-esta-chave
MINIO_SECRET_KEY=troque-esta-senha
MINIO_BUCKET=documents
MINIO_REGION=us-east-1

# JWT
JWT_SECRET=troque-por-um-segredo-forte
JWT_REFRESH_SECRET=troque-por-um-segredo-forte-refresh
JWT_EXPIRES_IN=15m

# Gateway
CORS_ORIGIN=https://transporte.hedsistemas.dev.br, https://apis.hedsistemas.dev.br, http://192.168.193.28:8081
