{
  "dependencies": {
    "@nestjs/mapped-types": "*",
    "pdfmake": "^0.3.3"
  },
  "name": "logistica-backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "gateway",
    "auth-service",
    "registry-service",
    "operations-service",
    "documents-service",
    "shared"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:gateway": "npm run start:dev --workspace=gateway",
    "dev:auth": "npm run start:dev --workspace=auth-service",
    "dev:registry": "npm run start:dev --workspace=registry-service",
    "dev:operations": "npm run start:dev --workspace=operations-service",
    "dev:documents": "npm run start:dev --workspace=documents-service",
    "dev:all": "concurrently \"npm:dev:*\"",
    "dev:monolith": "npm run start:dev --workspace=gateway",
    "start:monolith": "npm run start --workspace=gateway",
    "migrate:users-cpf": "node scripts/migrate-users-to-cpf.js",
    "set:user-cpf": "node scripts/set-user-cpf.js",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present -- --runInBand --passWithNoTests",
    "quality:report": "npm run lint",
    "validate": "npm run test && npm run build",
    "clean": "npm run clean --workspaces",
    "clean:dist": "rimraf gateway/dist auth-service/dist registry-service/dist operations-service/dist documents-service/dist shared/dist",
    "prisma:generate": "npm run prisma:generate --workspaces",
    "prisma:migrate": "npm run prisma:migrate --workspaces",
    "seed:db": "npm --workspace registry-service run seed:db && npm --workspace auth-service run seed:db"
  },
  "author": "Heger Valesin",
  "license": "ISC",
  "devDependencies": {
    "@types/pdfmake": "^0.3.0",
    "concurrently": "^8.2.2",
    "rimraf": "^6.0.1"
  }
}
